# Backend env example additions.
# Full backend template lives in .env.template; this file declares the notification
# delivery variables (Story 5.10 webhook HMAC + Story 2.2/2.3 wysylka i wiring).
#
# Operator checklist (co ustawic, skad wziac, co sie stanie bez tego):
# specs/operator/notification-delivery-deploy-checklist.md

# --- Wysylka: bez tych zmiennych nie wyjdzie zaden mail ---
# Brak => kazda wysylka failuje fail-loud BREVO_API_KEY_NOT_CONFIGURED.
BREVO_API_KEY=
# Mapa nadawcow per rynek (JSON). Brak wpisu => BREVO_SENDER_NOT_CONFIGURED.
# Przyklad: {"bonbeauty":{"email":"no-reply@example.com","name":"BonBeauty"}}
BREVO_SENDERS=
# Rynek dla call-site'ow administracyjnych bez kontekstu rynku (ADR-162).
GP_DEFAULT_MARKET_ID=
# Kanoniczna nazwa czytana przez brevo-hmac-validator.ts. Brak => kazdy inbound
# webhook dostaje 503 BREVO_HMAC_SECRET_UNSET.
BREVO_HMAC_SECRET=<your-brevo-hmac-secret>

# --- Wiring flag/KPI (ADR-161): nie blokuje wysylki, blokuje kontrole nad nia ---
# Brak (albo sciezka do nieistniejacego pliku) => fail-open + `warn`: kill-switch
# per flow/rynek NIE bramkuje. Wymagane na deployu bez checkoutu super-repo.
# ZMIEN poza lokalnym devem. Nie zostawiaj PUSTEJ wartosci: skrypty
# gp-config-sync-* uzywaja `??`, ktore nie lapie pustego stringa i wywala blad
# "instanceId is required" zamiast zejsc do domyslki `gp-dev`.
GP_INSTANCE_ID=gp-dev
GP_COMMUNICATION_DEFAULTS_PATH=
GP_COMMUNICATION_MARKET_FLOWS_DIR=
GP_COMMUNICATION_FLOW_APPROVALS_PATH=
# TTL cache wiringu w ms (domyslnie 60000). Wartosc nieliczbowa lub ujemna wraca
# cicho do 60000; cache wylacza wylacznie jawne 0.
GP_COMMUNICATION_WIRING_TTL_MS=

# Apple Wallet pozostaje domyślnie wyłączony w v1.10.0.
WALLET_APPLE_ENABLED=false

# Produkcyjne dane podpisywania Apple należy dodać dopiero po enrollment
# i tylko przez secret store w slocie v1.11.0+.

# --- Uwierzytelnienie sprzedawcy na /vendor/* (v1.15.0 Story 5.2, AD-20, ADR-182) ---
# Sekret HMAC jest rozwiazywany PER SPRZEDAWCE przez crypto-core backendu
# (packages/api/src/lib/vendor-secret/crypto-core.ts). VENDOR_SECRET_SET_PATH
# wskazuje na zaszyfrowany SOPS-em secret-set: {"entries":[{"seller_id","config_ref",
# "secret_b64"}]}. Deszyfrowanie odbywa sie RAZ na starcie procesu (loader
# vendor-secret-crypto-core), custody klucza prywatnego age to SOPS_AGE_KEY_FILE.
# NIEUSTAWIONE => cale /vendor/* odpowiada 503 VENDOR_AUTH_SECRET_STORE_UNAVAILABLE
# (glosna odmowa, nigdy ciche przepuszczenie ani fallback na wspolny sekret).
# Prowizjonowanie secret-setu jest zakresem ADR-182 §3 (provision-all) — patrz
# `_bmad-output/releases/v1.15.0/implementation-artifacts/deferred-work.md`.
VENDOR_SECRET_SET_PATH=
# Wspolny sekret. Do zamkniecia okna dwuwaznosci (closes_on w
# specs/contracts/security/vendor-secret-dual-window.v1.yaml) jest nadal WYMAGANY
# do startu (enforcement + drift w vendor-hmac-config.ts), ale NIE weryfikuje juz
# zadnego zadania. Usuwa go Story 5.4. Oba env-y sa wymagane naraz.
VENDOR_HMAC_SECRET=
VENDOR_HMAC_ENFORCED=true
VENDOR_HMAC_DRIFT_SECONDS=300
