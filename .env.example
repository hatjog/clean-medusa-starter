# Backend env example additions.
# Full backend template lives in .env.template; this file declares the notification
# delivery variables (Story 5.10 webhook HMAC + Story 2.2/2.3 wysylka i wiring).
#
# Operator checklist (co ustawic, skad wziac, co sie stanie bez tego):
# specs/operator/notification-delivery-deploy-checklist.md

# --- Wysylka: bez tych zmiennych nie wyjdzie zaden mail ---
# Brak => kazda wysylka failuje fail-loud BREVO_API_KEY_NOT_CONFIGURED.
BREVO_API_KEY=
# Mapa nadawcow per rynek (JSON). Brak wpisu => BREVO_SENDER_NOT_CONFIGURED.
# Przyklad: {"bonbeauty":{"email":"no-reply@example.com","name":"BonBeauty"}}
BREVO_SENDERS=
# Rynek dla call-site'ow administracyjnych bez kontekstu rynku (ADR-162).
GP_DEFAULT_MARKET_ID=
# Kanoniczna nazwa czytana przez brevo-hmac-validator.ts. Brak => kazdy inbound
# webhook dostaje 503 BREVO_HMAC_SECRET_UNSET.
BREVO_HMAC_SECRET=<your-brevo-hmac-secret>

# --- Wiring flag/KPI (ADR-161): nie blokuje wysylki, blokuje kontrole nad nia ---
# Brak (albo sciezka do nieistniejacego pliku) => fail-open + `warn`: kill-switch
# per flow/rynek NIE bramkuje. Wymagane na deployu bez checkoutu super-repo.
# ZMIEN poza lokalnym devem. Nie zostawiaj PUSTEJ wartosci: skrypty
# gp-config-sync-* uzywaja `??`, ktore nie lapie pustego stringa i wywala blad
# "instanceId is required" zamiast zejsc do domyslki `gp-dev`.
GP_INSTANCE_ID=gp-dev
GP_COMMUNICATION_DEFAULTS_PATH=
GP_COMMUNICATION_MARKET_FLOWS_DIR=
GP_COMMUNICATION_FLOW_APPROVALS_PATH=
# TTL cache wiringu w ms (domyslnie 60000). Wartosc nieliczbowa lub ujemna wraca
# cicho do 60000; cache wylacza wylacznie jawne 0.
GP_COMMUNICATION_WIRING_TTL_MS=

# Apple Wallet pozostaje domyślnie wyłączony w v1.10.0.
WALLET_APPLE_ENABLED=false

# Produkcyjne dane podpisywania Apple należy dodać dopiero po enrollment
# i tylko przez secret store w slocie v1.11.0+.

# --- Retencja bariery anty-replay /vendor/* (Story 5.3, ADR-185 D9, AD-21) ---
# Jawna, wyliczona lista rynkow (CSV), ktorych wolno dotknac sprzataczowi
# `vendor-replay-guard-purge`. BRAK ZMIENNEJ = ODMOWA, nie "wszystkie rynki":
# job nie kasuje niczego, podnosi metryke gp_system_market_context_denied_total
# i loguje GP_SYSTEM_MARKET_CONTEXT_DENIED. Werdykt bariery jest bez zmian
# (okno siedzi w predykacie) — rosnie wylacznie rozmiar tabeli.
# Przyklad: bonbeauty,testmarketb
VENDOR_REPLAY_GUARD_PURGE_MARKETS=

# --- Uwierzytelnienie sprzedawcy na /vendor/* (v1.15.0 Story 5.2, AD-20, ADR-182) ---
# Sekret HMAC jest rozwiazywany PER SPRZEDAWCE przez crypto-core backendu
# (packages/api/src/lib/vendor-secret/crypto-core.ts). VENDOR_SECRET_SET_PATH
# wskazuje na zaszyfrowany SOPS-em secret-set: {"entries":[{"seller_id","config_ref",
# "secret_b64"}]}. Deszyfrowanie odbywa sie RAZ na starcie procesu (loader
# vendor-secret-crypto-core), custody klucza prywatnego age to SOPS_AGE_KEY_FILE.
# NIEUSTAWIONE => cale /vendor/* odpowiada 503 VENDOR_AUTH_SECRET_STORE_UNAVAILABLE
# (glosna odmowa, nigdy ciche przepuszczenie ani fallback na wspolny sekret).
# Prowizjonowanie secret-setu jest zakresem ADR-182 §3 (provision-all) — patrz
# `_bmad-output/releases/v1.15.0/implementation-artifacts/deferred-work.md`.
VENDOR_SECRET_SET_PATH=
# Wspolny sekret VENDOR_HMAC_SECRET: Story 5.2 przestala nim weryfikowac zadania,
# a Story 5.4 (juz scalona) usunela go Z KODU — `vendor-hmac-config.ts` nie czyta
# go i nie rzuca przy jego braku. Nie ma tu wiec pozycji do ustawienia: poprawnie
# podpisane zadanie na /vendor/* dziala przy CALKOWICIE nieustawionej zmiennej.
# Okno dwuwaznosci (specs/contracts/security/vendor-secret-dual-window.v1.yaml)
# jest domkniete po stronie kodu przez 5.4. Zostaje wylacznie POLITYKA:
VENDOR_HMAC_ENFORCED=true
VENDOR_HMAC_DRIFT_SECONDS=300

# --- Retencja bariery idempotencji wysylki (Story 4.1, ADR-196 D11, AD-21) ---
# Jawna, wyliczona lista rynkow (CSV), ktorych wolno dotknac sprzataczowi
# `messaging-dispatch-barrier-purge` (cron 17 3 * * *). BRAK ZMIENNEJ = ODMOWA,
# nie "wszystkie rynki": job nie kasuje niczego, loguje odmowe
# markets_not_declared i wraca. Werdykt bariery jest bez zmian (okno siedzi
# w predykacie claim) — rosnie wylacznie rozmiar messaging_dispatch_barrier,
# bo bariera wstawia wiersz na KAZDA wysylke.
# Bez tego wpisu job wchodzil na fale MARTWY: zmienna nie istniala nigdzie poza
# wlasnym plikiem, wiec na kazdym srodowisku kasowal zero wierszy (R-4.1-H3).
# Przyklad: bonbeauty,testmarketb
MESSAGING_DISPATCH_BARRIER_PURGE_MARKETS=bonbeauty

# Jawna, wyliczona lista rynkow (CSV), ktore ocenia job eskalacji wieku
# `deferred-issuance-trace-age-escalation` (cron co 15 min, Story 4.5 AC2).
# BRAK ZMIENNEJ = ODMOWA: runInSystemMarketContext odrzuca markets_not_declared,
# job emituje ERROR DEFERRED_ISSUANCE_TRACE_AGE_ESCALATION_FAILED co przebieg
# (96 falszywych alarmow/dobe) i NIE ocenia populacji sladow — zaden slad
# ponad progiem wieku nie jest eskalowany. Wzorzec R-4.1-H3.
# Przyklad: bonbeauty,testmarketb
DEFERRED_ISSUANCE_TRACE_AGE_ESCALATION_MARKETS=bonbeauty

# Story 4.3 (FR-11, AD-48, D-33) — job `compensation-failure-recovery-alarm`
# (cron co 15 min) ocenia populacje compensation_failure po terminie na tych
# rynkach (CSV). BRAK ZMIENNEJ = ODMOWA: ERROR RECOVERY_COMPENSATION_ALARM_RUN_FAILED
# co przebieg i zadna kompensacja po terminie nie jest alarmowana. Wzorzec R-4.1-H3.
COMPENSATION_FAILURE_RECOVERY_ALARM_MARKETS=bonbeauty

# Story 11.3 (FR-11, AD-48, D-33) — job `recovery-population-alarm` (cron co 15 min)
# ocenia populacje deferred_issuance_trace i dlq_entry po terminie na tych rynkach
# (CSV), jeden alarm zbiorczy per populacja i rynek. BRAK ZMIENNEJ = ODMOWA:
# ERROR RECOVERY_POPULATION_ALARM_RUN_FAILED dostarczany trwalym kanalem.
RECOVERY_POPULATION_ALARM_MARKETS=bonbeauty
# Trwaly kanal alarmu recovery (lib/alert-channel.ts): lista uporzadkowana,
# pierwszy = podstawowy, kolejne = fallback; slownik: sentry, webhook.
# Brak dzialajacego kanalu = ERROR ALERT_CHANNEL_NOT_CONFIGURED / ALERT_CHANNEL_ALL_FAILED.
GP_ALERT_CHANNELS=sentry,webhook
# DSN Sentry (sekret — wartosc tylko w secret store, nie w repo).
GP_ALERT_SENTRY_DSN=
# Odbiornik webhook (POST JSON); np. kanal operatora niezalezny od Brevo.
GP_ALERT_WEBHOOK_URL=
# Limit jednej proby dostarczenia w ms (domyslnie 5000).
GP_ALERT_CHANNEL_TIMEOUT_MS=5000
