# ---------------------------------------------------------------------------
# Stripe — v1.8.0 BonBeauty live payment backend (ADR-100 / ADR-101 / ADR-120)
# ---------------------------------------------------------------------------
# v1.9.0 wf5 (closes CC-1 F-CC1-013): per-market env vars REQUIRED for any
# market listed in `STRIPE_ENABLED_MARKETS` (backend market-resolver.ts).
# Naming convention: STRIPE_<TYPE>_KEY_<MARKET_UPPER>.
# Replace BONBEAUTY with the uppercase market id for additional markets.
STRIPE_SECRET_KEY_BONBEAUTY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_KEY_BONBEAUTY=whsec_REPLACE_ME
# Publishable key is read by the storefront via NEXT_PUBLIC_STRIPE_KEY_BONBEAUTY;
# the backend SecretsAdapter signature also accepts `publishable` (reserved
# for GcpSecretsAdapter v1.10.0+).
STRIPE_PUBLISHABLE_KEY_BONBEAUTY=pk_test_REPLACE_ME

# Story 5.1 (FR-10): cienki webhook Path Y (/webhooks/stripe/payment-intent,
# helpers.ts STRIPE_WEBHOOK_SECRET_ENV) czyta sekret BEZ market-suffixu —
# celowo odrębny od market-scoped STRIPE_WEBHOOK_KEY_BONBEAUTY powyżej.
# Wartość = `whsec_...` z bieżącej sesji `stripe listen` (local dev, forwarder
# profilu `stripe`) — patrz docs/stripe-webhooks-local-dev.md.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Brevo / notification delivery — WYSYLKA (v1.14.0 Story 2.2/2.3)
# ---------------------------------------------------------------------------
# Pelny checklist operatorski (co ustawic, skad wziac, co sie stanie bez tego):
# specs/operator/notification-delivery-deploy-checklist.md
#
# Brak klucza API => provider startuje w trybie no-op-safe, a KAZDA wysylka
# failuje fail-loud BREVO_API_KEY_NOT_CONFIGURED (nigdy cichy no-op).
BREVO_API_KEY=
# Mapa nadawcow per rynek (JSON). Brak wpisu dla rynku => BREVO_SENDER_NOT_CONFIGURED;
# nadawca NIE jest podstawiany domyslnie.
# Przyklad: {"bonbeauty":{"email":"no-reply@example.com","name":"BonBeauty"}}
BREVO_SENDERS=
# Rynek dla call-site'ow administracyjnych bez kontekstu rynku (ADR-162).
# Nieustawiony => fallback `bonbeauty`; na instancji nie-BonBeauty ustaw jawnie.
GP_DEFAULT_MARKET_ID=
# Brevo inbound webhook signature validation (Story 5.10).
# Kanoniczna nazwa czytana przez api/middlewares/brevo-hmac-validator.ts
# (BREVO_HMAC_SECRET_ENV). Starsza nazwa z runbookow nie istnieje w runtime.
# Brak sekretu => kazdy inbound webhook dostaje 503 BREVO_HMAC_SECRET_UNSET.
# Local/dev placeholder only; nie commituj realnych sekretow.
BREVO_HMAC_SECRET=<your-brevo-hmac-secret>

# ---------------------------------------------------------------------------
# Communication wiring — flagi kill-switch + KPI (ADR-161, v1.14.0 Story 2.3)
# ---------------------------------------------------------------------------
# Modul Notification czyta konfiguracje flag/approvali z super-repo. Gdy backend
# jest deployowany BEZ checkoutu super-repo, auto-detekcja w gore od `cwd` nic
# nie znajdzie i wiring degraduje sie do fail-open: kazda wysylka przechodzi,
# kill-switch per flow/rynek nie bramkuje. Degradacja NIE jest cicha — leci
# `warn` w logach ("kill-switch per rynek/flow NIEAKTYWNY") — ale nie zatrzymuje
# ani bootu, ani wysylki. Ustaw wszystkie cztery na deployu bez super-repo.
#
# Sciezka wskazujaca NIEISTNIEJACY plik/katalog zachowuje sie dokladnie jak
# zmienna nieustawiona (fail-open + `warn`) — literowka nie jest wykrywana.
#
# UWAGA: zadeklarowanie ich tutaj nie wystarczy, jesli proces startuje przez
# docker compose albo gp-cli — te warstwy dzis NIE przekazuja tych zmiennych
# (ten sam brak dotyczy GP_ALERTING_CONFIG_PATH). Patrz checklist wyzej.
#
# !!! ZMIEN na kazdym srodowisku innym niz lokalny dev !!!
# Zostawiona wartosc `gp-dev` sprawi, ze wiring siegnie po
# gp-config/gp-dev/communication-defaults.yaml — czyli po cudzy plik defaults.
#
# Wartosc jest tu WYPELNIONA celowo: skrypty gp-config-sync-* czytaja
# `args[0] ?? process.env.GP_INSTANCE_ID ?? "gp-dev"`, a `??` NIE lapie pustego
# stringa — `GP_INSTANCE_ID=` (puste) wywraca je bledem
# "instanceId is required", zamiast zejsc do domyslki. Puste != nieustawione.
GP_INSTANCE_ID=gp-dev
# -> gp-config/<GP_INSTANCE_ID>/communication-defaults.yaml
GP_COMMUNICATION_DEFAULTS_PATH=
# -> gp-ops/markets/ (per rynek: <market>/communication-flows.yaml)
GP_COMMUNICATION_MARKET_FLOWS_DIR=
# -> gp-ops/markets/_ratification/communication-flow-approvals.yaml
GP_COMMUNICATION_FLOW_APPROVALS_PATH=
# TTL cache wiringu w ms (domyslnie 60000; 0 = zawsze swiezy odczyt z dysku).
# Wartosc nieliczbowa albo ujemna wraca CICHO do 60000 — nie da sie tak wylaczyc
# cache'u, do tego sluzy jawne 0.
GP_COMMUNICATION_WIRING_TTL_MS=

# Secrets adapter selection. Default `env` reads process.env directly.
# `gcp` is v1.10.0+ production posture (Google Cloud Secret Manager).
SECRETS_ADAPTER=env

# Google Wallet (Story 3.2) — Demo Issuer dla BonBeauty pilot.
# .env.local dopuszczalne w v1.10.0; GCP Secret Manager class google_wallet
# pozostaje docelowym zrodlem po aktywacji D-100. Nie commituj live key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_ID_TEMPLATE={issuer_id}.{market_code}_voucher_v1
GOOGLE_WALLET_MARKET_CODE=bonbeauty
GOOGLE_WALLET_ISSUER_NAME=Grow Platform
GOOGLE_WALLET_REQUEST_TIMEOUT_MS=2000

# --- Uwierzytelnienie sprzedawcy na /vendor/* (v1.15.0 Story 5.2, AD-20, ADR-182) ---
# Sekret HMAC jest rozwiazywany PER SPRZEDAWCE przez crypto-core backendu
# (packages/api/src/lib/vendor-secret/crypto-core.ts). VENDOR_SECRET_SET_PATH
# wskazuje na zaszyfrowany SOPS-em secret-set: {"entries":[{"seller_id","config_ref",
# "secret_b64"}]}. Deszyfrowanie odbywa sie RAZ na starcie procesu (loader
# vendor-secret-crypto-core), custody klucza prywatnego age to SOPS_AGE_KEY_FILE.
# NIEUSTAWIONE => cale /vendor/* odpowiada 503 VENDOR_AUTH_SECRET_STORE_UNAVAILABLE
# (glosna odmowa, nigdy ciche przepuszczenie ani fallback na wspolny sekret).
# Prowizjonowanie secret-setu jest zakresem ADR-182 §3 (provision-all) — patrz
# `_bmad-output/releases/v1.15.0/implementation-artifacts/deferred-work.md`.
VENDOR_SECRET_SET_PATH=
# Wspolny sekret. Do zamkniecia okna dwuwaznosci (closes_on w
# specs/contracts/security/vendor-secret-dual-window.v1.yaml) jest nadal WYMAGANY
# do startu (enforcement + drift w vendor-hmac-config.ts), ale NIE weryfikuje juz
# zadnego zadania. Usuwa go Story 5.4. Oba env-y sa wymagane naraz.
VENDOR_HMAC_SECRET=
VENDOR_HMAC_ENFORCED=true
VENDOR_HMAC_DRIFT_SECONDS=300
