{
  "name": "@gp/api",
  "version": "0.0.1",
  "private": true,
  "description": "GP backend (Medusa + Mercur) — Phase A1 rebase target per ADR-090/091/092.",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa",
    "mercur"
  ],
  "scripts": {
    "build": "medusa build && node ./scripts/mirror-built-api-routes.mjs",
    "start": "medusa start",
    "dev": "medusa develop",
    "db:migrate:app": "ts-node ./packages/api/src/scripts/run-app-migrations.ts",
    "db:migrate:app:status": "ts-node ./packages/api/src/scripts/run-app-migrations.ts status",
    "db:migrate:legacy-base": "GP_MIGRATION_SURFACE=legacy-base ts-node ./packages/api/src/scripts/run-app-migrations.ts",
    "db:migrate:legacy-base:status": "GP_MIGRATION_SURFACE=legacy-base ts-node ./packages/api/src/scripts/run-app-migrations.ts status",
    "db:migrate:all": "medusa db:migrate && pnpm run db:migrate:app",
    "typecheck": "tsc --noEmit",
    "mcp": "ts-node ./mcp/server.ts",
    "gp-config-mcp": "ts-node ./mcp/gp-config-mcp.ts",
    "gp-market-storefront-key": "ts-node ./mcp/gp-market-storefront-key.ts",
    "seed": "medusa exec ./packages/api/src/scripts/seed.ts",
    "commission-smoke": "medusa exec ./packages/api/src/scripts/commission-smoke.ts",
    "gp-fix-legacy-commission-schema": "ts-node ./packages/api/src/scripts/gp-fix-legacy-commission-schema.ts",
    "gp-config-sync-catalog": "medusa exec ./packages/api/src/scripts/gp-config-sync-catalog.ts",
    "gp-config-sync-orchestrator": "medusa exec ./packages/api/src/scripts/gp-config-sync-orchestrator.ts",
    "gp-config-sync-translations": "medusa exec ./packages/api/src/scripts/gp-config-sync-translations.ts",
    "gp-config-sync-i18n-content": "medusa exec ./packages/api/src/scripts/gp-config-sync-i18n-content.ts",
    "gp-config-content-bar": "medusa exec ./packages/api/src/scripts/gp-config-content-bar.ts",
    "gp-config-content-bar:standalone": "ts-node --transpile-only ./packages/api/src/scripts/gp-config-content-bar-standalone.ts",
    "gp-config-sync-shipping": "medusa exec ./packages/api/src/scripts/gp-config-sync-shipping.ts",
    "gp-config-sync-payments": "medusa exec ./packages/api/src/scripts/gp-config-sync-payments.ts",
    "gp-config-sync-media": "medusa exec ./packages/api/src/scripts/gp-config-sync-media.ts",
    "gp-config-sync-reviews": "medusa exec ./packages/api/src/scripts/gp-config-sync-reviews.ts",
    "gp-config-sync-accounts": "medusa exec ./packages/api/src/scripts/gp-config-sync-accounts.ts",
    "gp-config-sync-market-runtime": "medusa exec ./packages/api/src/scripts/gp-config-sync-market-runtime.ts",
    "gp-config-backfill-seller-columns": "medusa exec ./packages/api/src/scripts/gp-config-backfill-seller-columns.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:stripe-multi-order": "TEST_TYPE=stripe-multi-order NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "db:migrate:story-11-1": "node scripts/story-11-1-apply-runtime-recovery-migration.cjs",
    "db:migrate:story-4-2": "node scripts/story-4-2-apply-compensation-failure-migration.cjs",
    "test:integration:story-4-2-compensation-failure-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-2-compensation-failure-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-11-1-runtime-recovery-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-11-1-runtime-recovery-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-4-6-dlq-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-6-dlq-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-4-7-recovery-read-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-7-recovery-read-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-11-3-recovery-actions-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-11-3-recovery-actions-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:owed-unit-ack-pg": "TEST_TYPE=owed-unit-ack-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:completed-order-pg": "TEST_TYPE=completed-order-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:cart-completion-psp-authority-pg": "TEST_TYPE=cart-completion-psp-authority-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:replay-guard-pg": "TEST_TYPE=replay-guard-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:dispatch-barrier-pg": "TEST_TYPE=dispatch-barrier-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:dispatch-window-provider": "TEST_TYPE=dispatch-window-provider NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:addressing-axis-pg": "TEST_TYPE=addressing-axis-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-3-6-canonical-state-pg": "TEST_TYPE=story-3-6-canonical-state-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-3-3-shared-barrier-pg": "TEST_TYPE=story-3-3-shared-barrier-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-3-4-transport-reservation-pg": "TEST_TYPE=story-3-4-transport-reservation-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:voucher-rls": "TEST_TYPE=voucher-rls-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:voucher-redemption": "TEST_TYPE=voucher-redemption-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:redeem-for-seller": "TEST_TYPE=redeem-for-seller-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:voucher-service-redeem": "TEST_TYPE=voucher-service-redeem-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-4-4-deferred-trace-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-4-deferred-trace-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-4-5-trace-age-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-5-trace-age-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-4-3-compensation-alarm-pg": "GP_RUN_MIGRATION_INTEGRATION=1 TEST_TYPE=story-4-3-compensation-alarm-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:compensation-failure-pg": "TEST_TYPE=compensation-failure-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-8-4-partial-line-failure-pg": "TEST_TYPE=story-8-4-partial-line-failure-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-5-7-redemption-trail-pg": "TEST_TYPE=story-5-7-redemption-trail-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:story-6-5-recipient-pii-rls-pg": "TEST_TYPE=story-6-5-recipient-pii-rls-pg NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:patches": "TEST_TYPE=patches NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@gp/audit": "workspace:*",
    "@gp/messaging": "workspace:*",
    "@gp/voucher": "workspace:*",
    "@gp/wallet": "workspace:*",
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/icons": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/payment-stripe": "2.14.2",
    "@medusajs/ui": "4.0.25",
    "@mercurjs/cli": "2.1.1",
    "@mercurjs/core": "2.1.1",
    "@mercurjs/types": "2.1.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@sentry/node": "^9.0.0",
    "@touch4it/ical-timezones": "^1.9.0",
    "awilix": "^8.0.1",
    "http-proxy-middleware": "^3.0.5",
    "ical-generator": "10.2.0",
    "js-yaml": "^4.1.1",
    "pdfkit": "^0.15.0",
    "posthog-node": "^5.11.0",
    "qrcode": "^1.5.4",
    "resend": "^4.1.2",
    "yargs": "17.7.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@google-cloud/secret-manager": "6.1.2",
    "@medusajs/test-utils": "2.14.2",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "pdf-parse": "^1.1.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ],
    "overrides": {
      "@medusajs/admin-sdk": "2.14.2",
      "@medusajs/admin-shared": "2.14.2",
      "@medusajs/admin-vite-plugin": "2.14.2",
      "@medusajs/cli": "2.14.2",
      "@medusajs/dashboard": "2.14.2",
      "@medusajs/framework": "2.14.2",
      "@medusajs/icons": "2.14.2",
      "@medusajs/js-sdk": "2.14.2",
      "@medusajs/medusa": "2.14.2",
      "@medusajs/test-utils": "2.14.2",
      "@medusajs/types": "2.14.2"
    },
    "patchedDependencies": {
      "@mercurjs/core@2.1.1": "patches/@mercurjs__core@2.1.1.patch"
    }
  }
}
